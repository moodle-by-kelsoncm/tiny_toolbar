{{!
    @template tiny_toolbar/builder

    Visual builder of the toolbar layout. The groups and the available buttons are drawn by tiny_toolbar/builder.

    Context variables required for this template:
    * config - JSON with the initial layout, the presets and the menus
    * presets - list of presets with name and label
    * menus - list of menus with name and label

    Example context (json):
    {
        "config": "{}",
        "presets": [{"name": "minimal", "label": "Minimal"}],
        "menus": [{"name": "edit", "label": "Edit"}, {"name": "insert", "label": "Insert"}]
    }
}}
<div class="tiny-toolbar-builder mb-4" data-tiny-toolbar="builder" data-config="{{config}}">
    <div class="d-flex flex-wrap align-items-center mb-3">
        <label class="me-2 mb-0" for="tiny-toolbar-preset">{{#str}} loadpreset, tiny_toolbar {{/str}}</label>
        <select class="form-select w-auto me-2" id="tiny-toolbar-preset" data-tiny-toolbar="preset">
            <option value="">—</option>
            {{#presets}}
            <option value="{{name}}">{{label}}</option>
            {{/presets}}
        </select>
    </div>

    <fieldset class="mb-3">
        <legend class="h5">{{#str}} menubar, tiny_toolbar {{/str}}</legend>
        <div class="d-flex flex-wrap" data-tiny-toolbar="menus">
            {{#menus}}
            <div class="form-check me-3">
                <input class="form-check-input" type="checkbox" id="tiny-toolbar-menu-{{name}}" value="{{name}}" data-tiny-toolbar="menu">
                <label class="form-check-label" for="tiny-toolbar-menu-{{name}}">{{label}}</label>
            </div>
            {{/menus}}
        </div>
    </fieldset>

    <fieldset class="mb-3">
        <legend class="h5">{{#str}} quickbars, tiny_toolbar {{/str}}</legend>
        <div class="d-flex flex-wrap align-items-center">
            <select class="form-select w-auto me-2 mb-2" data-tiny-toolbar="quickbarsmode" aria-label="{{#str}} quickbars, tiny_toolbar {{/str}}">
                <option value="default">{{#str}} quickbars_default, tiny_toolbar {{/str}}</option>
                <option value="off">{{#str}} quickbars_off, tiny_toolbar {{/str}}</option>
                <option value="custom">{{#str}} quickbars_custom, tiny_toolbar {{/str}}</option>
            </select>
            <input type="text" class="form-control w-auto flex-grow-1 mb-2" maxlength="1000" data-tiny-toolbar="quickbars"
                aria-label="{{#str}} quickbars_custom, tiny_toolbar {{/str}}" placeholder="bold italic | h3 h4 blockquote">
        </div>
        <p class="text-muted small mb-0">{{#str}} quickbars_help, tiny_toolbar {{/str}}</p>
    </fieldset>

    <div class="row">
        <div class="col-lg-7 mb-3">
            <h3 class="h5">{{#str}} toolbar, tiny_toolbar {{/str}}</h3>
            <ol class="list-unstyled tiny-toolbar-groups" data-tiny-toolbar="groups"></ol>
            <button type="button" class="btn btn-secondary" data-tiny-toolbar="addgroup">{{#str}} addgroup, tiny_toolbar {{/str}}</button>
        </div>
        <div class="col-lg-5 mb-3">
            <h3 class="h5">{{#str}} availablebuttons, tiny_toolbar {{/str}}</h3>
            <p class="text-muted small">{{#str}} availablebuttons_help, tiny_toolbar {{/str}}</p>
            <div class="tiny-toolbar-available d-flex flex-wrap" data-tiny-toolbar="available"></div>
        </div>
    </div>
</div>
